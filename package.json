{
  "name": "pincenez",
  "version": "0.1.1",
  "description": "Grade LLM outputs against checks files using an LLM judge",
  "keywords": [
    "llm",
    "eval",
    "evaluation",
    "grader",
    "judge",
    "claude",
    "anthropic",
    "yaml",
    "cli",
    "testing"
  ],
  "author": "Benjamin Kudria <ben@kudria.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bkudria/pincenez.git"
  },
  "bugs": {
    "url": "https://github.com/bkudria/pincenez/issues"
  },
  "homepage": "https://github.com/bkudria/pincenez#readme",
  "type": "module",
  "bin": {
    "pincenez": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "tsx src/cli.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.143",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^15.0.0",
    "p-limit": "^7.3.0",
    "word-wrap": "^1.2.5",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "3.9.4",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
