{
  "name": "pincenez",
  "version": "0.0.0",
  "description": "Grade LLM outputs against checks files using an LLM judge",
  "keywords": [
    "llm",
    "eval",
    "evaluation",
    "grader",
    "judge",
    "claude",
    "anthropic",
    "yaml",
    "cli",
    "testing"
  ],
  "author": "Benjamin Kudria <ben@kudria.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bkudria/pincenez.git"
  },
  "bugs": {
    "url": "https://github.com/bkudria/pincenez/issues"
  },
  "homepage": "https://github.com/bkudria/pincenez#readme",
  "type": "module",
  "bin": {
    "pincenez": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "dev": "tsx src/cli.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.114",
    "commander": "^14.0.3",
    "p-limit": "^7.3.0",
    "yaml": "^2.8.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "prettier": "3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
